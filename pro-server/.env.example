# Copy to .env and edit.
# Public DNS name pointing at this server. Caddy gets a TLS certificate for it.
# Leave empty for plain HTTP on port 80 (testing only).
DOMAIN=pro.example.com

# Optional tuning (defaults shown)
# PRODUCTS=all            # or e.g. mrms-mesh,mrms-rotation,mrms-vil
# GOES_WIDTH=3000         # px; keep <= 4096 (mobile WebGL texture limit)
# MRMS_WIDTH=3500         # px; 3500 = 0.02 deg per px
# DASK_WORKERS=2          # threads for the GOES step
# KEEP_FRAMES=12
# POLL_SECONDS=120
