{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": { "*": false, "**": false, "main": true }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)shorts' ':(exclude)website' ':(exclude)docs' ':(exclude)pro-server' ':(exclude)android' ':(exclude)desktop' ':(exclude)store-assets' ':(exclude)branding' ':(exclude)examples' ':(exclude).github' ':(exclude)*.md'"
}
