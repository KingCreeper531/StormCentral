# ─── Database ────────────────────────────────────────────────────────────────
# Local development uses an embedded SQLite file (created automatically).
# For serverless deploys point this at a Turso/libSQL database (free tier).
DATABASE_URL=file:./data/stormcentral.db
# DATABASE_AUTH_TOKEN=
# Vercel's Turso integration sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead; either pair works.

# ─── Email (optional) ────────────────────────────────────────────────────────
# Password-reset email. Without SMTP_URL, a reset request answers that email isn't set up.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Storm Central <noreply@example.com>"
# The site's public address for links in emails (default: the address the request came from).
# PUBLIC_SITE_URL=https://app.stormcentralwx.com

# ─── Moderation ──────────────────────────────────────────────────────────────
# Usernames (comma-separated) who can review reported content and suspend accounts.
# MODERATORS=yourname
# Usernames shown with a "Developer" badge instead of their rank (default: StormCentral_Official).
# DEVELOPERS=yourname
# Moderators and developers can also put their map drawing on the 24/7 live stream (the drawing tools' on-air button).
# Usernames given the Trusted Spotter rank whatever their confirmations (WarnGen included),
# on top of the ones granted in src/lib/auth/session.ts.
# TRUSTED_SPOTTERS=yourname
# Professional mode's WarnGen (unofficial spotter-network warnings): the reputation needed to
# issue (default 25, the Trusted Spotter rank; 0 lets every member). Moderators and developers always can.
# WARNGEN_MIN_REPUTATION=25
# NOAA mPING: a token lets spotters send their reports on to mPING (ask the mPING team for API access).
# Without one the option isn't offered. MPING_API_URL overrides the API's address.
# MPING_TOKEN=
# MPING_API_URL=https://mping.ou.edu/mping/api/v2

# ─── Live storm chaser streams (optional) ────────────────────────────────────
# A YouTube Data API v3 key (Google Cloud console → Credentials → API key) lets the radar's
# Chasers tab show which storm chasers are live. Without one it lists their channels.
# YOUTUBE_API_KEY=
# More chaser channels to check, comma-separated @handles or channel ids.
# CHASER_CHANNELS=@somechaser,UCxxxxxxxxxxxxxxxxxxxxxx

# ─── Pro data server (optional) ──────────────────────────────────────────────
# Base URL of a pro-server/ deployment. Adds GOES Day Cloud Phase, Night Fog and
# Sandwich, and MRMS hail size, rotation tracks and VIL to Professional mode for
# every user. Those products stay hidden while this is empty.
# NEXT_PUBLIC_PRO_SERVER=https://pro.example.com

# ─── Base map (optional) ─────────────────────────────────────────────────────
# Without a key the app uses the keyless CARTO Dark Matter vector style.
# With a MapTiler key (free tier) you get MapTiler's dataviz style.
# NEXT_PUBLIC_MAPTILER_KEY=

# Where shared links point (map style links). A fork hosting its own copy sets
# its address; defaults to https://app.stormcentralwx.com.
# NEXT_PUBLIC_APP_URL=https://app.example.com

# ─── Upstream etiquette ──────────────────────────────────────────────────────
# api.weather.gov requires a User-Agent with contact info.
NWS_USER_AGENT="StormCentral/0.1 (github.com/KingCreeper531/StormCentral)"

# ─── Native apps (set by the build or by the desktop app; not needed for the web) ─
# Build-time, for the Windows/Android apps: the hosted Storm Central they load, so all
# users share one spotter network. Release builds use https://storm-central-pi.vercel.app
# unless the STORMCENTRAL_URL repository variable says otherwise.
# STORMCENTRAL_URL=https://stormcentral.example.com
#
# The desktop app's local server sets these itself (plain HTTP on 127.0.0.1):
# SESSION_COOKIE_SECURE=false
# ALLOWED_HOST=127.0.0.1:47613

