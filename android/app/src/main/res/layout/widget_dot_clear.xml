<?xml version="1.0" encoding="utf-8"?>
<!--
    "Dot" widget (StyledWidgetProvider, Style.DOT), in the style of Nothing OS:
    all text in a dot-matrix font (res/font/doto_round.ttf): a red dot and
    the place in capitals, the temperature large, then the sky and today's high
    and low, or the active warning in red. Wide widgets add the next hours on
    the right. This is the transparent twin of widget_dot.xml: white text with
    shadows so it reads on any wallpaper.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dot_clear"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/widget_main"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_dot_mark"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/widget_dot_mark"
                android:textColor="#FFFF3B3F"
                android:textSize="10sp" />

            <TextView
                android:fontFamily="@font/doto_round"
                android:id="@+id/widget_place"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#FFB3B3B3"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_temp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/doto_round"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_temp_unknown"
            android:textColor="#FFFFFFFF"
            android:textSize="64sp" />

        <TextView
            android:fontFamily="@font/doto_round"
            android:id="@+id/widget_condition"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:fontFamily="@font/doto_round"
            android:id="@+id/widget_hilo"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FF8C8C8C"
            android:textSize="13sp" />

        <TextView
            android:fontFamily="@font/doto_round"
            android:id="@+id/widget_message"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="#FFB3B3B3"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The next hours (wide widgets only): widget_dot_cell.xml rows. -->
    <LinearLayout
        android:id="@+id/widget_cells"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
