<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent twin of widget_dot_cell.xml (text shadows). One upcoming hour in widget_dot_clear.xml: the time and the temperature, in dots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cell"
    android:layout_width="wrap_content"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical|end"
    android:orientation="horizontal">

    <TextView
        android:fontFamily="@font/doto_round"
        android:id="@+id/widget_cell_label"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#FF8C8C8C"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_cell_value"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/doto_round"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minEms="2"
        android:gravity="end"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />
</LinearLayout>
