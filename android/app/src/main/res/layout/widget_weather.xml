<?xml version="1.0" encoding="utf-8"?>
<!--
    Home-screen weather widget (WeatherWidgetProvider.java). One layout for
    every size: the provider shows or hides rows to fit the current size.
    RemoteViews only inflates framework widgets that allow it, so this uses
    LinearLayout and TextView only. Colours follow docs/DESIGN.md: ink
    #ececed, ink-2 #a8acb3, ink-3 #80858d, nogo #e5484d.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFA8ACB3"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_temp_unknown"
            android:textColor="#FFECECED"
            android:textSize="40sp" />

        <!-- Condition and high/low beside the temperature (wide sizes). -->
        <LinearLayout
            android:id="@+id/widget_side"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFECECED"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_hilo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FFA8ACB3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Condition and high/low below the temperature (narrow sizes). -->
    <TextView
        android:id="@+id/widget_condition_below"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFECECED"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_hilo_below"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#FFA8ACB3"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="#FFE5484D"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF80858D"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Shown instead of everything above until the app has saved a place. -->
    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#FFA8ACB3"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
