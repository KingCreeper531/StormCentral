<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+): widget_dot.xml with sample values. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dot"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_dot_mark"
            android:textColor="#FFFF3B3F"
            android:textSize="10sp" />

        <TextView
            android:fontFamily="@font/doto_round"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_place"
            android:textAllCaps="true"
            android:textColor="#FFB3B3B3"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/doto_round"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_preview_temp"
        android:textColor="#FFFFFFFF"
        android:textSize="64sp" />

    <TextView
        android:fontFamily="@font/doto_round"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_condition"
        android:textAllCaps="true"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:fontFamily="@font/doto_round"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="@string/widget_preview_hilo"
        android:textAllCaps="true"
        android:textColor="#FF8C8C8C"
        android:textSize="13sp" />
</LinearLayout>
