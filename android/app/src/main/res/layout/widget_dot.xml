<?xml version="1.0" encoding="utf-8"?>
<!--
    "Dot" widget (StyledWidgetProvider, Style.DOT), in the style of Nothing OS:
    a red dot and the place in small capitals, the temperature large in a
    dot-matrix font (res/font/doto_round.ttf), then the sky and today's high
    and low, or the active warning in red. Wide widgets add the next hours on
    the right. widget_dot_clear.xml is its transparent twin (text shadows).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dot"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/widget_main"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_dot_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/widget_dot_mark"
                android:textColor="#FFFF3B3F"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#FFB3B3B3"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/doto_round"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_temp_unknown"
            android:textColor="#FFFFFFFF"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/widget_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_hilo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FF8C8C8C"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="#FFB3B3B3"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The next hours (wide widgets only): widget_dot_cell.xml rows. -->
    <LinearLayout
        android:id="@+id/widget_cells"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
