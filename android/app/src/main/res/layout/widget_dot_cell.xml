<?xml version="1.0" encoding="utf-8"?>
<!-- One upcoming hour in widget_dot.xml: the time in small capitals, the temperature in dots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cell"
    android:layout_width="wrap_content"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical|end"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_cell_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#FF8C8C8C"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_cell_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/doto_round"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minEms="2"
        android:gravity="end"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />
</LinearLayout>
