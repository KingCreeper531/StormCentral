<?xml version="1.0" encoding="utf-8"?>
<!-- "Clock" widget style (StyledWidgetProvider). Sizes follow weather_widget_info.xml. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description_clock"
    android:initialLayout="@layout/widget_clock"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:previewLayout="@layout/widget_preview_clock"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
