{
  "type": "plugin",
  "name": "Map boundaries",
  "author": "StormCentral",
  "description": "US county and state lines over the radar.",
  "version": "1.0.0",
  "layers": [
    {
      "type": "raster",
      "id": "counties",
      "name": "Counties",
      "tiles": [
        "https://mesonet.agron.iastate.edu/cache/tile.py/1.0.0/uscounties/{z}/{x}/{y}.png"
      ],
      "maxzoom": 12,
      "opacity": 0.6,
      "attribution": "Boundaries: Iowa Environmental Mesonet"
    },
    {
      "type": "raster",
      "id": "states",
      "name": "States",
      "tiles": [
        "https://mesonet.agron.iastate.edu/cache/tile.py/1.0.0/usstates/{z}/{x}/{y}.png"
      ],
      "maxzoom": 12,
      "opacity": 0.8,
      "visible": false,
      "attribution": "Boundaries: Iowa Environmental Mesonet"
    }
  ]
}
