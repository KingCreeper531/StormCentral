# Storm Central X bot settings. start.ps1 copies this to settings.env on the
# first run; change settings.env, not this file.

# The only account the bot may post as. Cookies for any other account are refused.
BOT_X_ACCOUNT=Storm__Central

# Posts per day (UTC), emergencies always posted. Keep it modest: twikit posts
# as the logged-in account, and X locks accounts that post like a machine.
BOT_DAILY_LIMIT=30
# Posts per run, and seconds between posts.
BOT_MAX_PER_RUN=3
BOT_MIN_GAP_S=60
# Minutes between runs, in seconds (120 at least).
BOT_INTERVAL_S=300

# The morning SPC outlook post, and the Storm Central links in posts.
BOT_OUTLOOK=true
BOT_LINKS=true
