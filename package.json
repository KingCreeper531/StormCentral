{
  "name": "stormcentral",
  "version": "0.1.0",
  "private": true,
  "description": "Next-generation open-data weather platform: immersive forecasts, NEXRAD radar, drone, angler and air-quality modes, plus a community spotter network.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "node scripts/vendor-maplibre-worker.mjs",
