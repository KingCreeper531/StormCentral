{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "redirects": [
    { "source": "/app", "destination": "https://storm-central-pi.vercel.app/", "permanent": false },
    { "source": "/windows", "destination": "https://apps.microsoft.com/detail/9P3SXT2T0CLQ", "permanent": false },
    { "source": "/github", "destination": "https://github.com/KingCreeper531/StormCentral", "permanent": false },
    { "source": "/privacy", "destination": "https://storm-central-pi.vercel.app/privacy", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(assets|vendor)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
